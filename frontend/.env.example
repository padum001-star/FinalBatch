EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Set to 1 to run the app against an in-memory fake instead of Supabase:
# no login screen, seeded listings/reservations, nothing persisted.
# Ignored outside development builds. Leave unset once the two values above are real.
EXPO_PUBLIC_DEMO_MODE=0
