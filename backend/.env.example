PORT=3001
# Use DATABASE_URL, or leave it blank and configure the separate PG fields.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=finalbatch
PGUSER=postgres
PGPASSWORD=
# For AWS RDS, use certs/rds-global-bundle.pem (download from AWS).
PGSSLROOTCERT=
# Generate separately with: openssl rand -hex 32
SESSION_SECRET=
JWT_SECRET=
# Google Cloud OAuth client type must be Web application.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URL in Google Cloud > Authorized redirect URIs.
# Use a publicly reachable HTTPS API URL for a phone/production.
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Native development/production build:
APP_AUTH_REDIRECT=finalbatch://auth
# For web instead: http://localhost:8081/auth (one deployment target at a time)
CORS_ORIGINS=http://localhost:8081
# Set this to your own email. Public signup cannot create this account.
ADMIN_EMAIL=
# Only set when running npm run create-admin; remove afterwards.
ADMIN_PASSWORD=
